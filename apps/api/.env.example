# NODE_ENV: development | staging | production | test
NODE_ENV=development
PORT=3000

# ---- Database -----------------------------------------------------------
# dev:        postgres://auction:auction@localhost:5432/auction
# staging:    postgres://USER:PASS@staging-host:5432/auction (set in host)
# production: postgres://USER:PASS@prod-host:5432/auction    (set in host)
DATABASE_URL=postgres://auction:auction@localhost:5432/auction
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---- CORS ---------------------------------------------------------------
# dev:        local Vite/Astro ports
# staging:    https://staging.auctionit.ai,https://app.staging.auctionit.ai,...
# production: https://auctionit.ai,https://app.auctionit.ai,https://bid.auctionit.ai,https://admin.auctionit.ai
CORS_ORIGINS=http://localhost:4321,http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---- Sessions / Cookies -------------------------------------------------
# Base name. Per-app cookies are derived as `<base>_<role>` (e.g.
# auction_session_admin) so admin / bidder / client logins stay isolated even
# though all four frontends call one API.
SESSION_COOKIE_NAME=auction_session
SESSION_TTL_DAYS=30

# Origins that identify each frontend app. Comma-separated. Match against the
# request's Origin header to pick the right cookie name.
# Dev defaults below match each app's vite.config.ts port.
# Prod (set in deployment env, not here):
#   APP_ADMIN_ORIGINS=https://admin.auctionit.ai
#   APP_BIDDER_ORIGINS=https://bid.auctionit.ai
#   APP_CLIENT_ORIGINS=https://app.auctionit.ai
APP_ADMIN_ORIGINS=http://localhost:5175
APP_BIDDER_ORIGINS=http://localhost:5174
APP_CLIENT_ORIGINS=http://localhost:5173
# COOKIE_DOMAIN: empty in dev (host-only). In prod set to .auctionit.ai for SSO across subdomains.
# COOKIE_DOMAIN=.auctionit.ai
# COOKIE_SECURE auto-derives from NODE_ENV (true in staging/prod). Override only if needed.
# COOKIE_SECURE=true

# ---- Logging ------------------------------------------------------------
# Optional. Defaults: dev=debug, staging/prod=info, test=warn
# LOG_LEVEL=info

# ---- File storage -------------------------------------------------------
# STORAGE_DRIVER: local (dev) | r2 (staging/prod)
STORAGE_DRIVER=local
# Local driver: directory (relative to apps/api or absolute) for uploaded files. Gitignored.
STORAGE_LOCAL_DIR=uploads
# Max upload size per file, in bytes. Default 10 MiB.
STORAGE_MAX_UPLOAD_BYTES=10485760
# Comma-separated mime allowlist. Defaults match the bidder doc upload set (jpg/png/gif/pdf/doc/docx).
# STORAGE_ALLOWED_MIME=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# R2 driver (Cloudflare R2 — S3-compatible). Required only when STORAGE_DRIVER=r2.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Optional public CDN base URL if the bucket is exposed via a public hostname.
# R2_PUBLIC_BASE_URL=https://files.auctionit.ai

# ---- SMS (OTP delivery) -------------------------------------------------
# SMS_DRIVER: stub (dev — logs OTP to API console) | analytics_mantra (prod — real SMS)
SMS_DRIVER=stub

# Required only when SMS_DRIVER=analytics_mantra. Username + password come from
# the Analytics Mantra portal — keep these out of git, set them as Render/Fly secrets.
# SMS_USERNAME=
# SMS_PASSWORD=

# Defaults below match the existing JindalX/JIAUCT DLT registration. Override
# only if your DLT entries change.
# SMS_BASE_URL=https://bulksms.analyticsmantra.com/sendsms/sendsms.php
# SMS_SENDER_ID=JIAUCT
# SMS_TYPE=TEXT
# SMS_DLT_PEID=1101616050000022954
# SMS_DLT_HEADER_ID=1205160327544676712
# SMS_DLT_TEMPLATE_ID=1207161778554839403
# SMS_SUCCESS_TOKEN=SUBMIT_SUCCESS

# DLT-registered template content. Must match the registered template
# character-for-character apart from the {OTP} placeholder, otherwise the
# gateway silently drops the message. Default matches the JindalX template:
# SMS_OTP_TEMPLATE={OTP} is your Authorization OTP for login verification. OTP will expire in 15 minutes. Regards- JindalX

# Verbose SMS logs. true = log full message body (incl. OTP) and gateway
# response. false = log only metadata (recipient, message length, status,
# latency). Default true. Recommend false in production.
# SMS_LOG_ENABLED=true

# ---- Seed admins (consumed by `pnpm db:seed`) ---------------------------
# Single admin (defaults shown):
SEED_ADMIN_EMAIL=admin@auctionit.ai
SEED_ADMIN_NAME=Auction Admin
SEED_ADMIN_PASSWORD=changeme123
# Or seed multiple admins (overrides the singles above):
# SEED_ADMINS=[{"email":"a@x.com","name":"A","password":"changeme123"},{"email":"b@x.com","name":"B","password":"changeme123"}]
