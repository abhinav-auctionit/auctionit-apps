generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  client
  bidder

  @@map("user_role")
}

enum AuctionStatus {
  draft
  scheduled
  live
  ended
  cancelled

  @@map("auction_status")
}

enum AuctionType {
  forward
  reverse
  sealed_bid
  yankee

  @@map("auction_type")
}

enum AttributeType {
  text
  number
  single_select
  multi_select

  @@map("attribute_type")
}

enum Uom {
  MT
  KG
  NOS
  PCS
  LTR
  BAG
  CUM
  BOX

  @@map("uom")
}

enum InterestedIn {
  forward
  reverse
  both

  @@map("interested_in")
}

enum CompanyType {
  llp
  llc
  individual
  limited
  partnership
  pvt_limited
  sole_proprietorship

  @@map("company_type")
}

enum BusinessActivity {
  broker
  end_user
  trader
  other

  @@map("business_activity")
}

enum SubscriptionType {
  annual
  lifetime

  @@map("subscription_type")
}

enum BidderStatus {
  draft
  pending_approval
  approved
  rejected

  @@map("bidder_status")
}

enum OtpChannel {
  mobile
  email

  @@map("otp_channel")
}

enum WalletTxnKind {
  admin_credit
  admin_debit_correction
  emd_hold
  emd_release
  emd_forfeit

  @@map("wallet_txn_kind")
}

enum LotOutcomeStatus {
  pending_lift
  lifted
  forfeited
  rejected_by_client
  no_winner

  @@map("lot_outcome_status")
}

enum OtherChargeType {
  flat
  percentage

  @@map("other_charge_type")
}

enum StaggeringOfLots {
  none
  all_lots
  subsequent_lots

  @@map("staggering_of_lots")
}

enum EngagementPurpose {
  auction_follow_up
  auction_debrief
  complaint_escalation
  invoice_query
  general_check_in
  other

  @@map("engagement_purpose")
}

enum EngagementMedium {
  phone_call
  email
  in_person
  video_call
  whatsapp
  other

  @@map("engagement_medium")
}

enum ClientInternalContactRole {
  kam
  asst_kam
  lifting_coordinator
  catalog_ops

  @@map("client_internal_contact_role")
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique @db.VarChar(255)
  name              String   @db.VarChar(255)
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  mobileCountryCode String?  @map("mobile_country_code") @db.VarChar(8)
  mobileNumber      String?  @map("mobile_number") @db.VarChar(20)
  role              UserRole @default(bidder)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions           Session[]
  createdAuctions    Auction[]           @relation("AuctionCreatedBy")
  bids               Bid[]
  uploadedFiles      StoredFile[]
  bidderProfile      BidderProfile?
  recordedWalletTxns WalletTransaction[] @relation("WalletTxnCreatedBy")
  loggedEngagements  ClientEngagement[]  @relation("EngagementLoggedBy")
  clientAssignments  ClientInternalContact[]
  wonLots            Lot[]               @relation("LotWinner")
  attachedLotParticipations     LotParticipation[]     @relation("LotParticipationAttachedBy")
  attachedAuctionParticipations AuctionParticipation[] @relation("AuctionParticipationAttachedBy")

  @@unique([mobileCountryCode, mobileNumber], map: "users_mobile_unique")
  @@map("users")
}

model BidderProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Personal
  interestedIn        InterestedIn @map("interested_in")
  fullName            String       @map("full_name") @db.VarChar(255)
  contactCountryCode  String       @map("contact_country_code") @db.VarChar(8)
  contactNumber       String       @map("contact_number") @db.VarChar(20)
  whatsappCountryCode String       @map("whatsapp_country_code") @db.VarChar(8)
  whatsappNumber      String       @map("whatsapp_number") @db.VarChar(20)

  // Company (nullable until wizard step 2 saves)
  companyName      String?           @map("company_name") @db.VarChar(255)
  companyType      CompanyType?      @map("company_type")
  businessActivity BusinessActivity? @map("business_activity")
  address          String?           @db.Text
  country          String?           @db.VarChar(64)
  state            String?           @db.VarChar(128)
  city             String?           @db.VarChar(128)
  pinCode          String?           @map("pin_code") @db.VarChar(16)
  designation      String?           @db.VarChar(128)
  secondaryNumber  String?           @map("secondary_number") @db.VarChar(32)
  registeredEmail  String?           @map("registered_email") @db.VarChar(255)
  gst              String?           @db.VarChar(32)
  pan              String?           @db.VarChar(16)

  // Documents
  panCardFileId         String? @map("pan_card_file_id") @db.Uuid
  proofOfAddressFileId  String? @map("proof_of_address_file_id") @db.Uuid
  cancelledChequeFileId String? @map("cancelled_cheque_file_id") @db.Uuid
  otherFileId           String? @map("other_file_id") @db.Uuid
  bankAccountNumber     String? @map("bank_account_number") @db.VarChar(64)
  bankName              String? @map("bank_name") @db.VarChar(255)
  ifscCode              String? @map("ifsc_code") @db.VarChar(16)

  // Terms
  termsAcceptedAt      DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  signatoryName        String?   @map("signatory_name") @db.VarChar(255)
  signatoryDesignation String?   @map("signatory_designation") @db.VarChar(128)
  signatoryPlace       String?   @map("signatory_place") @db.VarChar(128)
  signatoryDate        DateTime? @map("signatory_date") @db.Date

  // Payment (offline)
  subscriptionType      SubscriptionType? @map("subscription_type")
  registrationFeePaid   Boolean           @default(false) @map("registration_fee_paid")
  registrationFeePaidAt DateTime?         @map("registration_fee_paid_at") @db.Timestamptz(6)
  registrationFeeNote   String?           @map("registration_fee_note") @db.Text

  // Workflow
  status        BidderStatus @default(draft)
  submittedAt   DateTime?    @map("submitted_at") @db.Timestamptz(6)
  approvedAt    DateTime?    @map("approved_at") @db.Timestamptz(6)
  rejectedAt    DateTime?    @map("rejected_at") @db.Timestamptz(6)
  rejectionNote String?      @map("rejection_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  panCardFile           StoredFile?            @relation("BidderPanCard", fields: [panCardFileId], references: [id], onDelete: SetNull)
  proofOfAddressFile    StoredFile?            @relation("BidderProofOfAddress", fields: [proofOfAddressFileId], references: [id], onDelete: SetNull)
  cancelledChequeFile   StoredFile?            @relation("BidderCancelledCheque", fields: [cancelledChequeFileId], references: [id], onDelete: SetNull)
  otherFile             StoredFile?            @relation("BidderOther", fields: [otherFileId], references: [id], onDelete: SetNull)
  wallet                BidderWallet?
  lotParticipations     LotParticipation[]
  auctionParticipations AuctionParticipation[]

  @@index([status], map: "bidder_profiles_status_idx")
  @@map("bidder_profiles")
}

model BidderWallet {
  id              String   @id @default(uuid()) @db.Uuid
  bidderProfileId String   @unique @map("bidder_profile_id") @db.Uuid
  balance         Int      @default(0)
  lockedBalance   Int      @default(0) @map("locked_balance")
  currency        String   @default("INR") @db.VarChar(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  bidderProfile BidderProfile       @relation(fields: [bidderProfileId], references: [id], onDelete: Cascade)
  transactions  WalletTransaction[]

  @@map("bidder_wallets")
}

model WalletTransaction {
  id            String        @id @default(uuid()) @db.Uuid
  walletId      String        @map("wallet_id") @db.Uuid
  kind          WalletTxnKind
  amount        Int
  balanceAfter  Int           @map("balance_after")
  referenceType String?       @map("reference_type") @db.VarChar(32)
  referenceId   String?       @map("reference_id") @db.Uuid
  note          String?       @db.Text
  createdById   String?       @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  wallet    BidderWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("WalletTxnCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt(sort: Desc)], map: "wallet_txn_wallet_idx")
  @@map("wallet_transactions")
}

model OtpChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  channel    OtpChannel
  target     String     @db.VarChar(255)
  codeHash   String     @map("code_hash") @db.VarChar(255)
  purpose    String     @db.VarChar(64)
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([channel, target], map: "otp_challenges_target_idx")
  @@index([expiresAt], map: "otp_challenges_expires_idx")
  @@map("otp_challenges")
}

model StoredFile {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique @db.VarChar(512)
  originalName String   @map("original_name") @db.VarChar(512)
  mimeType     String   @map("mime_type") @db.VarChar(127)
  sizeBytes    Int      @map("size_bytes")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  uploadedBy              User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  bidderPanCardOf         BidderProfile[] @relation("BidderPanCard")
  bidderProofOfAddressOf  BidderProfile[] @relation("BidderProofOfAddress")
  bidderCancelledChequeOf BidderProfile[] @relation("BidderCancelledCheque")
  bidderOtherOf           BidderProfile[] @relation("BidderOther")
  clientTncOf             Client[]        @relation("ClientTnc")

  @@index([uploadedById], map: "stored_files_uploader_idx")
  @@map("stored_files")
}

model Client {
  id                String  @id @default(uuid()) @db.Uuid
  companyName       String  @map("company_name") @db.VarChar(100)
  phone             String? @db.VarChar(20)
  websiteUrl        String? @map("website_url") @db.VarChar(100)
  registeredAddress String  @map("registered_address") @db.VarChar(500)
  country           String  @db.VarChar(64)

  pan      String  @db.VarChar(10)
  tan      String  @db.VarChar(10)
  tin      String  @db.VarChar(15)
  isActive Boolean @default(true) @map("is_active")

  prefixAuctionCode String? @map("prefix_auction_code") @db.VarChar(25)
  suffixAuctionCode String? @map("suffix_auction_code") @db.VarChar(25)

  autoExtend                     Boolean           @default(false) @map("auto_extend")
  extendIfLastBidSec             Int?              @map("extend_if_last_bid_sec")
  extendDurationSec              Int?              @map("extend_duration_sec")
  extensionMaxTimes              Int?              @map("extension_max_times")
  staggeringOfLots               StaggeringOfLots? @map("staggering_of_lots")
  staggeringOfLotsDurationSec    Int?              @map("staggering_of_lots_duration_sec")
  staggeringOfAuction            Boolean?          @map("staggering_of_auction")
  staggeringOfAuctionDurationSec Int?              @map("staggering_of_auction_duration_sec")

  otherChargeType   OtherChargeType? @map("other_charge_type")
  otherChargeAmount Int?             @map("other_charge_amount")
  revenueRate       Int              @map("revenue_rate")

  plantTechPersonDetails String? @map("plant_tech_person_details") @db.VarChar(200)

  displayMaterialLocation Boolean @default(false) @map("display_material_location")
  displayPlantLocation    Boolean @default(false) @map("display_plant_location")

  tncFileId String?     @map("tnc_file_id") @db.Uuid
  tncFile   StoredFile? @relation("ClientTnc", fields: [tncFileId], references: [id], onDelete: SetNull)
  auctions  Auction[]
  locations ClientLocation[]
  engagements ClientEngagement[]
  internalContacts ClientInternalContact[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([pan], map: "clients_pan_unique")
  @@index([isActive], map: "clients_is_active_idx")
  @@map("clients")
}

model ClientLocation {
  id        String  @id @default(uuid()) @db.Uuid
  clientId  String  @map("client_id") @db.Uuid
  name      String  @db.VarChar(120)
  addressLine String? @map("address_line") @db.VarChar(255)
  city      String  @db.VarChar(80)
  state     String  @db.VarChar(80)
  pincode   String  @db.VarChar(15)
  country   String  @db.VarChar(64)
  isPrimary Boolean @default(false) @map("is_primary")

  client   Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contacts ClientContactPoint[]
  auctions Auction[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([clientId], map: "client_locations_client_idx")
  @@map("client_locations")
}

model ClientEngagement {
  id          String            @id @default(uuid()) @db.Uuid
  clientId    String            @map("client_id") @db.Uuid
  happenedAt  DateTime          @map("happened_at") @db.Timestamptz(6)
  personName  String            @map("person_name") @db.VarChar(120)
  personRole  String?           @map("person_role") @db.VarChar(120)
  purpose     EngagementPurpose
  medium      EngagementMedium
  comments    String            @db.Text
  createdById String?           @map("created_by_id") @db.Uuid

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("EngagementLoggedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([clientId, happenedAt(sort: Desc)], map: "client_engagements_client_happened_idx")
  @@map("client_engagements")
}

model ClientInternalContact {
  id         String                    @id @default(uuid()) @db.Uuid
  clientId   String                    @map("client_id") @db.Uuid
  userId     String                    @map("user_id") @db.Uuid
  role       ClientInternalContactRole
  assignedAt DateTime                  @default(now()) @map("assigned_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([clientId, role], map: "client_internal_contacts_client_role_unique")
  @@index([userId], map: "client_internal_contacts_user_idx")
  @@map("client_internal_contacts")
}

model ClientContactPoint {
  id          String  @id @default(uuid()) @db.Uuid
  locationId  String  @map("location_id") @db.Uuid
  name        String  @db.VarChar(120)
  role        String? @db.VarChar(120)
  email       String? @db.VarChar(255)
  phone       String? @db.VarChar(30)

  location ClientLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([locationId], map: "client_contact_points_location_idx")
  @@map("client_contact_points")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_idx")
  @@index([expiresAt], map: "sessions_expires_idx")
  @@map("sessions")
}

model Auction {
  id                    String        @id @default(uuid()) @db.Uuid
  clientId              String        @map("client_id") @db.Uuid
  locationId            String?       @map("location_id") @db.Uuid
  code                  String        @unique @db.VarChar(64)
  name                  String        @db.VarChar(255)
  auctionType           AuctionType   @map("auction_type")
  status                AuctionStatus @default(draft)
  consolidatedEmdAmount Int?          @map("consolidated_emd_amount")
  description           String?
  createdById           String?       @map("created_by_id") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  client       Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  location     ClientLocation?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy    User?                  @relation("AuctionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lots         Lot[]
  participants AuctionParticipation[]

  @@index([clientId], map: "auctions_client_idx")
  @@index([status], map: "auctions_status_idx")
  @@index([locationId], map: "auctions_location_idx")
  @@map("auctions")
}

model Lot {
  id                    String            @id @default(uuid()) @db.Uuid
  auctionId             String            @map("auction_id") @db.Uuid
  lotNo                 Int               @map("lot_no")
  itemId                String?           @map("item_id") @db.Uuid
  itemName              String            @map("item_name") @db.VarChar(255)
  description           String?
  qty                   Decimal           @db.Decimal(14, 4)
  uom                   Uom
  auctionDate           DateTime          @map("auction_date") @db.Date
  startTime             DateTime          @map("start_time") @db.Timestamptz(6)
  endTime               DateTime          @map("end_time") @db.Timestamptz(6)
  startingPriceCents    Int               @map("starting_price_cents")
  bidIncrementCents     Int               @default(100) @map("bid_increment_cents")
  emdAmount             Int               @map("emd_amount")
  winnerId              String?           @map("winner_id") @db.Uuid
  winningBidAmountCents Int?              @map("winning_bid_amount_cents")
  outcomeStatus         LotOutcomeStatus? @map("outcome_status")
  liftedAt              DateTime?         @map("lifted_at") @db.Timestamptz(6)
  forfeitedAt           DateTime?         @map("forfeited_at") @db.Timestamptz(6)
  rejectedAt            DateTime?         @map("rejected_at") @db.Timestamptz(6)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  auction      Auction            @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  item         Item?              @relation(fields: [itemId], references: [id], onDelete: SetNull)
  winner       User?              @relation("LotWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  bids         Bid[]
  participants LotParticipation[]

  @@unique([auctionId, lotNo], map: "lots_auction_lot_no_unique")
  @@index([auctionId], map: "lots_auction_idx")
  @@index([startTime], map: "lots_start_time_idx")
  @@map("lots")
}

model LotParticipation {
  id              String    @id @default(uuid()) @db.Uuid
  lotId           String    @map("lot_id") @db.Uuid
  bidderProfileId String    @map("bidder_profile_id") @db.Uuid
  emdHeldAmount   Int       @map("emd_held_amount")
  attachedById    String?   @map("attached_by_id") @db.Uuid
  attachedAt      DateTime  @default(now()) @map("attached_at") @db.Timestamptz(6)
  releasedAt      DateTime? @map("released_at") @db.Timestamptz(6)
  holdTxnId       String?   @map("hold_txn_id") @db.Uuid
  releaseTxnId    String?   @map("release_txn_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lot           Lot           @relation(fields: [lotId], references: [id], onDelete: Cascade)
  bidderProfile BidderProfile @relation(fields: [bidderProfileId], references: [id], onDelete: Cascade)
  attachedBy    User?         @relation("LotParticipationAttachedBy", fields: [attachedById], references: [id], onDelete: SetNull)

  @@unique([lotId, bidderProfileId], map: "lot_participations_lot_bidder_unique")
  @@index([bidderProfileId], map: "lot_participations_bidder_idx")
  @@map("lot_participations")
}

model AuctionParticipation {
  id                        String    @id @default(uuid()) @db.Uuid
  auctionId                 String    @map("auction_id") @db.Uuid
  bidderProfileId           String    @map("bidder_profile_id") @db.Uuid
  consolidatedEmdHeldAmount Int       @map("consolidated_emd_held_amount")
  attachedById              String?   @map("attached_by_id") @db.Uuid
  attachedAt                DateTime  @default(now()) @map("attached_at") @db.Timestamptz(6)
  settledAt                 DateTime? @map("settled_at") @db.Timestamptz(6)
  settlementRefundAmount    Int?      @map("settlement_refund_amount")
  settlementForfeitAmount   Int?      @map("settlement_forfeit_amount")
  settlementShortfallAmount Int       @default(0) @map("settlement_shortfall_amount")
  holdTxnId                 String?   @map("hold_txn_id") @db.Uuid
  settleRefundTxnId         String?   @map("settle_refund_txn_id") @db.Uuid
  settleForfeitTxnId        String?   @map("settle_forfeit_txn_id") @db.Uuid
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  auction       Auction       @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderProfile BidderProfile @relation(fields: [bidderProfileId], references: [id], onDelete: Cascade)
  attachedBy    User?         @relation("AuctionParticipationAttachedBy", fields: [attachedById], references: [id], onDelete: SetNull)

  @@unique([auctionId, bidderProfileId], map: "auction_participations_auction_bidder_unique")
  @@index([bidderProfileId], map: "auction_participations_bidder_idx")
  @@map("auction_participations")
}

model Bid {
  id          String   @id @default(uuid()) @db.Uuid
  lotId       String   @map("lot_id") @db.Uuid
  bidderId    String   @map("bidder_id") @db.Uuid
  amountCents Int      @map("amount_cents")
  placedAt    DateTime @default(now()) @map("placed_at") @db.Timestamptz(6)

  lot    Lot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  bidder User @relation(fields: [bidderId], references: [id])

  @@index([lotId, placedAt(sort: Desc)], map: "bids_lot_idx")
  @@index([bidderId], map: "bids_bidder_idx")
  @@map("bids")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(255)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subcategories Subcategory[]

  @@map("categories")
}

model Subcategory {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  name       String   @db.VarChar(255)
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items    Item[]

  @@unique([categoryId, name], map: "subcategories_category_id_name_unique")
  @@map("subcategories")
}

model Attribute {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @unique @db.VarChar(255)
  type        AttributeType
  unit        String?       @db.VarChar(32)
  description String?
  position    Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  options             AttributeOption[]
  itemAttributeValues ItemAttributeValue[]

  @@map("attributes")
}

model AttributeOption {
  id          String   @id @default(uuid()) @db.Uuid
  attributeId String   @map("attribute_id") @db.Uuid
  value       String   @db.VarChar(255)
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, value], map: "attribute_options_attribute_id_value_unique")
  @@map("attribute_options")
}

model Item {
  id             String   @id @default(uuid()) @db.Uuid
  subcategoryId  String   @map("subcategory_id") @db.Uuid
  name           String   @db.VarChar(255)
  uom            Uom
  hsnCode        String   @map("hsn_code") @db.VarChar(32)
  benchmarkCents Int?     @map("benchmark_cents")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subcategory     Subcategory          @relation(fields: [subcategoryId], references: [id], onDelete: NoAction)
  attributeValues ItemAttributeValue[]
  lots            Lot[]

  @@map("items")
}

model ItemAttributeValue {
  id             String   @id @default(uuid()) @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  attributeId    String?  @map("attribute_id") @db.Uuid
  customName     String?  @map("custom_name") @db.VarChar(255)
  valueText      String?  @map("value_text")
  valueNumber    Decimal? @map("value_number") @db.Decimal(14, 4)
  valueOptionIds String[] @map("value_option_ids") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  item      Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  attribute Attribute? @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([itemId, attributeId], map: "item_attribute_values_item_id_attribute_id_unique")
  @@map("item_attribute_values")
}
