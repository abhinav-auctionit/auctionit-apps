---
import BaseLayout from '../layouts/BaseLayout.astro';

// SSR per request — fresh auctions list on every visit, fully indexable.
export const prerender = false;

type AuctionStatus = 'scheduled' | 'live';
type UpcomingAuction = {
  id: string;
  title: string;
  description: string | null;
  startingPriceCents: number;
  currentPriceCents: number;
  status: AuctionStatus;
  startsAt: string;
  endsAt: string;
};

const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000';
const bidderUrl = import.meta.env.PUBLIC_BIDDER_URL ?? 'https://bid.auctionit.ai';

let auctions: UpcomingAuction[] = [];
let fetchError: string | null = null;

try {
  const res = await fetch(`${apiUrl}/api/public/auctions/upcoming`, {
    headers: { Accept: 'application/json' },
  });
  if (!res.ok) throw new Error(`api ${res.status}`);
  auctions = (await res.json()) as UpcomingAuction[];
} catch (err) {
  fetchError = err instanceof Error ? err.message : 'unknown error';
}

const inr = new Intl.NumberFormat('en-IN', {
  style: 'currency',
  currency: 'INR',
  maximumFractionDigits: 0,
});
const formatCents = (cents: number) => inr.format(cents / 100);
const formatWhen = (iso: string) =>
  new Date(iso).toLocaleString('en-IN', {
    weekday: 'short',
    day: 'numeric',
    month: 'short',
    hour: 'numeric',
    minute: '2-digit',
    timeZone: 'Asia/Kolkata',
  });
---

<BaseLayout
  title="Upcoming Auctions · Auction-it"
  description="Browse upcoming and live industrial auctions on Auction-it. Sign in to bid."
>
  <section class="mx-auto max-w-6xl px-6 py-12">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-3">
      <div>
        <p
          class="text-xs font-semibold uppercase tracking-wider"
          style="color: hsl(var(--brand-mint-strong))"
        >
          Live & upcoming
        </p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight sm:text-4xl">
          Upcoming auctions
        </h1>
        <p class="mt-2 text-sm text-muted-foreground">
          {
            auctions.length === 0 && !fetchError
              ? 'No auctions scheduled right now. Check back soon.'
              : `${auctions.length} listing${auctions.length === 1 ? '' : 's'} · refreshed every visit`
          }
        </p>
      </div>
      <a
        href={`${bidderUrl}/register`}
        class="inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-medium transition hover:opacity-90"
        style="background: hsl(var(--brand-mint)); color: hsl(var(--brand-mint-fg))"
      >
        Register to bid
      </a>
    </div>

    {fetchError && (
      <div class="mb-6 surface-card border-destructive/30 bg-destructive/5 p-4 text-sm">
        <p class="font-medium text-destructive">Couldn't load auctions.</p>
        <p class="mt-1 text-muted-foreground">{fetchError}</p>
      </div>
    )}

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        auctions.map((a) => (
          <li class="surface-card flex h-full flex-col gap-3 p-5">
            <div class="flex items-start justify-between gap-3">
              <h2 class="text-base font-medium leading-snug">{a.title}</h2>
              <span
                class:list={[
                  'shrink-0 rounded-full px-2 py-0.5 text-xs font-medium',
                  a.status === 'live' ? 'pill-mint' : 'bg-secondary text-muted-foreground',
                ]}
              >
                {a.status === 'live' ? (
                  <span class="inline-flex items-center gap-1.5">
                    <span
                      class="inline-block h-1.5 w-1.5 rounded-full"
                      style="background: hsl(var(--destructive))"
                    />
                    Live now
                  </span>
                ) : (
                  'Scheduled'
                )}
              </span>
            </div>
            {a.description && (
              <p class="line-clamp-2 text-sm text-muted-foreground">{a.description}</p>
            )}
            <dl class="tabular mt-auto grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
              <dt class="text-muted-foreground">Starts</dt>
              <dd class="text-foreground">{formatWhen(a.startsAt)}</dd>
              <dt class="text-muted-foreground">Current bid</dt>
              <dd class="font-medium">{formatCents(a.currentPriceCents)}</dd>
            </dl>
            <a
              href={`${bidderUrl}/auctions/${a.id}`}
              class="text-sm font-medium hover:underline"
              style="color: hsl(var(--brand-mint-strong))"
            >
              View on bidder app →
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
