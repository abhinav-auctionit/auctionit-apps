---
export interface Props {
  title: string;
  body: string;
  /** Lucide-style stroke-width-2 SVG glyph identifier, or just an emoji label. */
  icon?: 'shield' | 'trending-up' | 'users' | 'eye' | 'globe' | 'clipboard-check' | 'sparkles' | 'database' | 'plug' | 'bar-chart' | 'bell' | 'workflow';
}

const { title, body, icon } = Astro.props;
---

<article class="surface-card flex h-full flex-col gap-3 p-6">
  {icon && (
    <span
      class="inline-flex h-9 w-9 items-center justify-center rounded-md"
      style="background: hsl(var(--brand-mint) / 0.18); color: hsl(var(--brand-mint-strong))"
      aria-hidden="true"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
      >
        {icon === 'shield' && <path d="M12 2 4 6v6c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V6z" />}
        {icon === 'trending-up' && (
          <>
            <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />
            <polyline points="16 7 22 7 22 13" />
          </>
        )}
        {icon === 'users' && (
          <>
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
          </>
        )}
        {icon === 'eye' && (
          <>
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
            <circle cx="12" cy="12" r="3" />
          </>
        )}
        {icon === 'globe' && (
          <>
            <circle cx="12" cy="12" r="10" />
            <line x1="2" y1="12" x2="22" y2="12" />
            <path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z" />
          </>
        )}
        {icon === 'clipboard-check' && (
          <>
            <rect x="8" y="2" width="8" height="4" rx="1" />
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
            <path d="m9 14 2 2 4-4" />
          </>
        )}
        {icon === 'sparkles' && (
          <path d="M12 2v4m0 12v4M4 12H0m24 0h-4m-1.5-7.5L16 7M8 17l-2.5 2.5M19.5 19.5 17 17M8 7 5.5 4.5" />
        )}
        {icon === 'database' && (
          <>
            <ellipse cx="12" cy="5" rx="9" ry="3" />
            <path d="M3 5v6c0 1.7 4 3 9 3s9-1.3 9-3V5" />
            <path d="M3 11v6c0 1.7 4 3 9 3s9-1.3 9-3v-6" />
          </>
        )}
        {icon === 'plug' && (
          <>
            <path d="M9 2v6" />
            <path d="M15 2v6" />
            <path d="M7 8h10v4a5 5 0 0 1-5 5 5 5 0 0 1-5-5z" />
            <path d="M12 17v5" />
          </>
        )}
        {icon === 'bar-chart' && (
          <>
            <line x1="12" y1="20" x2="12" y2="10" />
            <line x1="18" y1="20" x2="18" y2="4" />
            <line x1="6" y1="20" x2="6" y2="14" />
          </>
        )}
        {icon === 'bell' && (
          <>
            <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
            <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
          </>
        )}
        {icon === 'workflow' && (
          <>
            <rect x="3" y="3" width="6" height="6" rx="1" />
            <rect x="15" y="15" width="6" height="6" rx="1" />
            <path d="M9 6h6a3 3 0 0 1 3 3v6" />
          </>
        )}
      </svg>
    </span>
  )}
  <h3 class="text-base font-semibold">{title}</h3>
  <p class="text-sm leading-relaxed text-muted-foreground">{body}</p>
</article>
