---
const sections = [
  {
    title: 'Platform',
    links: [
      { href: '/forward-auction', label: 'Forward Auction' },
      { href: '/reverse-auction', label: 'Reverse Auction' },
      { href: '/materials', label: 'Materials Auctioned' },
      { href: '/platform', label: 'The Platform' },
      { href: '/auctions', label: 'Live Auctions' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About Auction-it' },
      { href: '/contact', label: 'Contact' },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-card">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-8 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 font-semibold tracking-tight">
          <span
            class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-primary text-primary-foreground"
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
              <path d="M14 4l6 6-9 9H5v-6z" />
              <path d="M3 21h18" />
            </svg>
          </span>
          <span>Auction-it</span>
        </div>
        <p class="mt-3 max-w-md text-sm text-muted-foreground">
          India's leading e-Auction platform for industrial scrap, surplus, and secondary
          materials. Powered by JindalX, part of the O.P. Jindal Group.
        </p>
        <dl class="mt-6 space-y-1 text-sm">
          <div class="flex gap-2">
            <dt class="text-muted-foreground">Email</dt>
            <dd>
              <a href="mailto:info@auctionit.in" class="hover:text-foreground"
                >info@auctionit.in</a
              >
            </dd>
          </div>
          <div class="flex gap-2">
            <dt class="text-muted-foreground">Phone</dt>
            <dd>
              <a href="tel:+919935889777" class="hover:text-foreground">+91 99358 89777</a>
            </dd>
          </div>
          <div class="flex gap-2">
            <dt class="text-muted-foreground">Address</dt>
            <dd>28, Shivaji Marg, New Delhi 110015, India</dd>
          </div>
        </dl>
      </div>

      {
        sections.map((s) => (
          <div>
            <h3 class="text-sm font-semibold">{s.title}</h3>
            <ul class="mt-3 space-y-2">
              {s.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="text-sm text-muted-foreground hover:text-foreground"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-border pt-6 text-xs text-muted-foreground sm:flex-row sm:items-center"
    >
      <p>© {year} Auction-it · A JindalX initiative.</p>
      <p>ISO 9001 · ISO 14001 · ISO 27001 certified</p>
    </div>
  </div>
</footer>
