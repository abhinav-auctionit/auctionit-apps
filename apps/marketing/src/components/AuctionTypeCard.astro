---
export interface Props {
  title: string;
  body: string;
  href?: string;
  cta?: string;
}

const { title, body, href, cta = 'Learn more' } = Astro.props;
---

<article class="surface-card flex h-full flex-col gap-4 p-6">
  <h3 class="text-lg font-semibold">{title}</h3>
  <p class="text-sm leading-relaxed text-muted-foreground">{body}</p>
  {href && (
    <a
      href={href}
      class="mt-auto inline-flex items-center gap-1 text-sm font-medium hover:underline"
      style="color: hsl(var(--brand-mint-strong))"
    >
      {cta}
      <span aria-hidden="true">→</span>
    </a>
  )}
</article>
