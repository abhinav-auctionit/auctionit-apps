---
const metrics = [
  { value: '9,000+', label: 'Registered Bidders' },
  { value: '70,000+', label: 'Tons Sold Monthly' },
  { value: '350+', label: 'Locations Covered' },
  { value: '₹2,500 Cr+', label: 'Annual Transaction Value' },
];
---

<div class="border-y border-border bg-card">
  <div class="mx-auto grid max-w-6xl grid-cols-2 divide-y divide-border px-6 sm:grid-cols-4 sm:divide-x sm:divide-y-0">
    {
      metrics.map((m, i) => (
        <div
          class:list={[
            'tabular flex flex-col gap-1 px-2 py-6 text-center sm:py-8',
            i === 0 && 'sm:pl-0',
            i === metrics.length - 1 && 'sm:pr-0',
          ]}
        >
          <span class="text-2xl font-semibold tracking-tight sm:text-3xl">{m.value}</span>
          <span class="text-xs uppercase tracking-wider text-muted-foreground sm:text-sm">
            {m.label}
          </span>
        </div>
      ))
    }
  </div>
</div>
