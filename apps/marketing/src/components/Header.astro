---
const links = [
  { href: '/auctions', label: 'Live auctions' },
  { href: '/forward-auction', label: 'Forward' },
  { href: '/reverse-auction', label: 'Reverse' },
  { href: '/materials', label: 'Materials' },
  { href: '/platform', label: 'Platform' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const bidderUrl = import.meta.env.PUBLIC_BIDDER_URL ?? 'https://bid.auctionit.ai';
const clientUrl = import.meta.env.PUBLIC_APP_URL ?? 'https://app.auctionit.ai';

const audienceMenus = [
  {
    id: 'bidders',
    label: 'For Bidders',
    blurb: 'Buy industrial materials at competitive prices.',
    items: [
      { label: 'Sign in', href: bidderUrl, kind: 'link' as const },
      { label: 'Register as a Bidder', href: `${bidderUrl}/register`, kind: 'cta' as const },
    ],
  },
  {
    id: 'clients',
    label: 'For Clients',
    blurb: 'Sell scrap, surplus, or run procurement auctions.',
    items: [
      { label: 'Sign in', href: clientUrl, kind: 'link' as const },
      { label: 'Talk to sales', href: '/contact', kind: 'cta' as const },
    ],
  },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  class="sticky top-0 z-40 text-primary-foreground"
  style="background: hsl(218 50% 12%);"
>
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-6 px-6">
    <a href="/" class="flex items-center gap-2 text-base font-semibold tracking-tight">
      <span
        class="inline-flex h-6 w-6 items-center justify-center rounded-md"
        style="background: hsl(var(--brand-mint)); color: hsl(var(--brand-mint-fg));"
        aria-hidden="true"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-3.5 w-3.5"
        >
          <path d="M14 4l6 6-9 9H5v-6z" />
          <path d="M3 21h18" />
        </svg>
      </span>
      <span>AuctionIt</span>
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      {
        links.map((l) => {
          const active = currentPath === l.href;
          return (
            <a
              href={l.href}
              class:list={[
                'text-sm transition-colors',
                active
                  ? 'font-semibold text-primary-foreground'
                  : 'text-primary-foreground/55 hover:text-primary-foreground',
              ]}
            >
              {l.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      {
        audienceMenus.map((m) => (
          <details class="audience-menu relative" data-audience-menu>
            <summary
              class="flex cursor-pointer list-none items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-primary-foreground/85 transition hover:bg-primary-foreground/10 hover:text-primary-foreground"
              aria-haspopup="menu"
            >
              <span class="hidden sm:inline">{m.label}</span>
              <span class="sm:hidden">{m.label.replace('For ', '')}</span>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-3.5 w-3.5 transition-transform"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <div
              class="absolute right-0 top-full z-50 mt-2 w-64 overflow-hidden rounded-lg border border-border bg-card text-foreground shadow-lg"
              role="menu"
            >
              <div class="border-b border-border px-4 py-3">
                <p class="text-sm font-semibold">{m.label}</p>
                <p class="mt-0.5 text-xs text-muted-foreground">{m.blurb}</p>
              </div>
              <ul class="p-2">
                {m.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      role="menuitem"
                      class:list={[
                        'flex items-center justify-between rounded-md px-3 py-2 text-sm transition-colors',
                        item.kind === 'cta'
                          ? 'font-medium hover:bg-secondary'
                          : 'text-foreground hover:bg-secondary',
                      ]}
                      style={
                        item.kind === 'cta'
                          ? 'color: hsl(var(--brand-mint-strong))'
                          : ''
                      }
                    >
                      <span>{item.label}</span>
                      <span class="text-muted-foreground" aria-hidden="true">
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</header>

<style is:global>
  /* Hide the default disclosure marker that <summary> renders */
  details[data-audience-menu] > summary::-webkit-details-marker {
    display: none;
  }
  details[data-audience-menu] > summary {
    list-style: none;
  }
  details[data-audience-menu][open] > summary svg {
    transform: rotate(180deg);
  }
</style>

<script>
  // Close any open audience-menu when clicking outside, pressing Escape,
  // or opening the other one.
  const menus = document.querySelectorAll<HTMLDetailsElement>('details[data-audience-menu]');

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    menus.forEach((d) => {
      if (d.open && !d.contains(target)) d.open = false;
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') menus.forEach((d) => (d.open = false));
  });

  menus.forEach((d) => {
    d.addEventListener('toggle', () => {
      if (!d.open) return;
      menus.forEach((other) => {
        if (other !== d) other.open = false;
      });
    });
  });
</script>
